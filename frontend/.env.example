# Frontend environment. Copy to .env.local. Only VITE_-prefixed values reach the browser,
# so never put secrets here (no service-role keys, no SMS or AI provider credentials).

# Base URL of the FastAPI backend (no trailing slash needed).
VITE_API_BASE_URL=http://localhost:8000

# development | test | staging | production
VITE_APP_ENV=development

# Supabase public values (the anon key is designed to be public; RLS protects data).
# Not used until Phase 1 (authentication). Leave blank for now.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
