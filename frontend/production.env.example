# Production environment template for the frontend (set in Vercel -> Project -> Settings ->
# Environment Variables). Values are compiled into the public bundle, so nothing here may be a
# secret. No Supabase keys are needed: the SPA talks only to the Chikka API.

# Public https origin of the backend, no trailing slash. The build fails if it is missing or not
# https when VITE_APP_ENV is staging or production. WebSockets use the same host (wss://).
VITE_API_BASE_URL=https://<api domain>
# staging | production
VITE_APP_ENV=production
