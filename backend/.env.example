# Backend environment. Copy to .env (never commit .env). All secrets come from the environment.

# development | test | staging | production
APP_ENV=development
LOG_LEVEL=INFO

# Comma-separated list of allowed browser origins. "*" is rejected.
CORS_ORIGINS=http://localhost:5173

# Supabase Postgres connection string. Leave blank to run without a database
# (the health endpoint then reports database "not_configured").
# Find it in Supabase > Project Settings > Database > Connection string.
# Both postgresql:// and postgresql+asyncpg:// are accepted.
DATABASE_URL=

# Supabase Auth and Storage. The JWT secret verifies access tokens on protected routes.
# Backend only: never copy the JWT secret or the service-role key into the frontend.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Access-token verification. Projects on the new signing keys (ES256/RS256) need nothing extra:
# the public keys are read from SUPABASE_URL/auth/v1/.well-known/jwks.json. Override with
# SUPABASE_JWKS_URL if needed. Projects still on the legacy HS256 secret set SUPABASE_JWT_SECRET.
SUPABASE_JWT_SECRET=
SUPABASE_JWKS_URL=
# Needed to disable a deleted account and to store profile photos.
SUPABASE_SERVICE_ROLE_KEY=
AVATAR_BUCKET=avatars
ATTACHMENT_BUCKET=message-attachments

# Keys rate-limit and OTP hashes. Required (32+ characters) in staging and production.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=

# The SPA origin used in email links. COOKIE_SECURE defaults to on outside development.
FRONTEND_BASE_URL=http://localhost:5173
COOKIE_SECURE=
TERMS_VERSION=2026-11-01
PRIVACY_VERSION=2026-11-01

# SMS provider. "mock" (simulation) sends nothing and costs nothing. "live" is refused at
# startup unless SMS_LIVE_CONFIRMED=true is also set by an operator for this environment.
SMS_PROVIDER_MODE=mock
SMS_LIVE_CONFIRMED=false

# Live mode only (SMS_PROVIDER_MODE=live). Startup fails if any is missing; it never falls back
# to simulation. The Twilio auth token also signs Twilio's webhooks. See
# docs/deployment/sms-live-activation.md before enabling live SMS.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Public HTTPS origin of this backend. Twilio signs the exact URL it calls.
SMS_PUBLIC_BASE_URL=

# Simulation and worker tuning (optional).
SMS_MOCK_WEBHOOK_SECRET=
SMS_WORKER_ENABLED=true
SMS_WORKER_POLL_SECONDS=1
SMS_AMBIGUOUS_WINDOW_SECONDS=900
SMS_QUEUE_MAX_AGE_SECONDS=86400
SMS_ATTESTATION_VERSION=2026-11-01

# Connection pool tuning (optional).
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
