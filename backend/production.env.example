# Production environment template for the backend. This file is documentation: enter the real
# values in the hosting platform's secret store, never in a file in the repository.
# Every <placeholder> must be replaced. `python -m app.preflight` checks the result at start-up.
# Variable reference: docs/deployment/environment-configuration.md

# ── Application ────────────────────────────────────────────────────────────────────────────
# staging | production
APP_ENV=production
LOG_LEVEL=INFO
# 48+ random characters. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it invalidates pending OTPs and rate-limit counters, not user sessions.
APP_SECRET_KEY=<secret: 48+ random characters>

# The SPA origin. It must share a registrable domain with this API (see the deployment guide,
# "Same-site domains"), for example app.example.com and api.example.com.
FRONTEND_BASE_URL=https://<app domain>
# Exact origins only, comma-separated, https. Must include FRONTEND_BASE_URL's origin.
CORS_ORIGINS=https://<app domain>
# Leave unset: secure cookies are on by default in staging and production.
# COOKIE_SECURE=
TERMS_VERSION=<version of the published Terms>
PRIVACY_VERSION=<version of the published Privacy Notice>

# ── Server (read by uvicorn, not by the app) ────────────────────────────────────────────────
# Addresses of the platform's reverse proxy. Only these may set X-Forwarded-For. Use the
# platform's documented proxy range; use "*" only if the container is reachable solely through
# that proxy. Wrong values make every client look like one address (shared rate limits).
FORWARDED_ALLOW_IPS=<proxy address or range>
# PORT is injected by most platforms. The image defaults to 8000.

# ── Supabase ───────────────────────────────────────────────────────────────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon / publishable key>
# Backend only. Bypasses RLS. Never in the frontend, never in logs.
SUPABASE_SERVICE_ROLE_KEY=<service-role / secret key>
# Leave SUPABASE_JWT_SECRET unset when the project uses asymmetric signing keys. The public keys
# are read from SUPABASE_URL/auth/v1/.well-known/jwks.json.
# SUPABASE_JWT_SECRET=
AVATAR_BUCKET=avatars
ATTACHMENT_BUCKET=message-attachments

# Supabase "Connect" -> Session pooler or Direct connection (port 5432). The transaction pooler
# also works (prepared statements are disabled in code). Use a dedicated database role for the
# backend where possible. TLS is required by Supabase.
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/postgres
# Per instance. Keep pool_size + max_overflow below the plan's connection limit.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10

# ── SMS ────────────────────────────────────────────────────────────────────────────────────
# Stays "mock" (simulation) until docs/deployment/twilio-configuration.md is complete and a named
# person approves live sending.
SMS_PROVIDER_MODE=mock
SMS_LIVE_CONFIRMED=false
SMS_WORKER_ENABLED=true
# Live mode only. All three are required then, and the server refuses to start without them.
# TWILIO_ACCOUNT_SID=<secret>
# TWILIO_AUTH_TOKEN=<secret>
# The public https origin of THIS backend, exactly as Twilio calls it (no path, no trailing slash).
# SMS_PUBLIC_BASE_URL=https://<api domain>
# Keys the simulation's webhook signer. Optional; random per process when unset.
# SMS_MOCK_WEBHOOK_SECRET=

# ── Email (sign-up confirmation and password reset are sent by Supabase Auth, not here) ─────
# "smtp" sends notification emails. "mock" sends nothing.
EMAIL_PROVIDER_MODE=mock
NOTIFICATIONS_WORKER_ENABLED=true
# EMAIL_FROM_ADDRESS=<sender address>
# SMTP_HOST=<host>
# SMTP_PORT=587
# SMTP_USERNAME=<secret>
# SMTP_PASSWORD=<secret>
# SMTP_STARTTLS=true

# ── AI ─────────────────────────────────────────────────────────────────────────────────────
# "mock" returns canned drafts. "bedrock" needs all three BEDROCK_* values or the server will
# not start. See docs/deployment/bedrock-setup.md.
AI_PROVIDER_MODE=mock
# BEDROCK_REGION=<aws region where the model is enabled>
# BEDROCK_MODEL_ID=<model or inference-profile id>
# BEDROCK_API_KEY=<secret: Bedrock API key>
AI_TIMEOUT_SECONDS=15
AI_MAX_OUTPUT_TOKENS=600
